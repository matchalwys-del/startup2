{
  "manifest_version": 3,
  "name": "Chevron - Custom New Tab",
  "version": "2.0.0",
  "description": "Clean, fast, and customizable productivity new tab page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "action": {
    "default_title": "Chevron New Tab"
  }
}